{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/test-imports",
      "destination": "/api/resources?module=test-imports"
    },
    {
      "source": "/api/validation-report",
      "destination": "/api/health?report=1"
    },
    {
      "source": "/api/ai-tutor",
      "destination": "/api/health?tutor=1"
    }
  ],
  "headers": [
    {
      "source": "/generated/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "functions": {
    "api/resources.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{@tesseract.js-data,tesseract.js-core,pdfjs-dist}/**"
    },
    "api/*.js": {
      "maxDuration": 60
    }
  }
}
